{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "site": "stocksoft",
    "public": "public",
    "cleanUrls": true,
    "headers": [
      { "source": "**", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(png|jpg|svg|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/tasas.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
    ]
  }
}
